{
  "mcpServers": {
    "{{ plan.slug }}": {
{% if plan.transport == "stdio" %}
      "command": "uv",
      "args": ["--directory", ".", "run", "python", "server.py"]
{% else %}
      "url": "http://localhost:8000{% if plan.transport == 'sse' %}/sse{% else %}/mcp{% endif %}",
      "transport": "{{ plan.transport }}"
{% endif %}
    }
  }
}
