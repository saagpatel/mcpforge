{% set endpoint_path = "/sse" if plan.transport == "sse" else "/mcp" %}
{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.12",
    "dependencies": [
      "fastmcp>=3.1.0",
      "mcp>=1.30.0"{% for package in plan.external_packages %},
      "{{ package }}"{% endfor %}
    ]
  },
  "deployment": {
    "transport": "{% if plan.transport == 'streamable-http' %}http{% else %}{{ plan.transport }}{% endif %}",
    "host": "127.0.0.1",
    "port": 8000,
    "path": "{{ endpoint_path }}",
    "log_level": "INFO",
    "profiles": {
      "local_stdio": {
        "transport": "stdio",
        "command": "fastmcp run server.py"
      },
      "local_http": {
        "transport": "{% if plan.transport == 'sse' %}sse{% else %}http{% endif %}",
        "url": "http://127.0.0.1:8000{{ endpoint_path }}"
      },
      "production_http": {
        "transport": "{% if plan.transport == 'sse' %}sse{% else %}http{% endif %}",
        "url": "https://your-domain.example{{ endpoint_path }}",
        "requires_auth": {% if plan.auth_profile %}true{% else %}false{% endif %}
      }
    }
  }
}
