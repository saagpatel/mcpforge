{
  "name": "timeout_after_partial",
  "mode": "timeout",
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "id",
      "value"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "value": {
        "type": "string"
      }
    }
  },
  "script": [
    {
      "emit": {
        "id": 1,
        "value": "ok"
      }
    },
    {
      "hang": true
    }
  ],
  "contract": {
    "retryable": true,
    "partial_result_allowed": true
  },
  "expect": {
    "status": "incomplete",
    "failure": {
      "kind": "timeout",
      "retryable": true,
      "partial_result": true,
      "detail": "upstream timed out"
    },
    "items": [
      {
        "id": 1,
        "value": "ok"
      }
    ]
  }
}
